<div class="contextual">
  <% if @risk.editable? %>
    <%= link_to l(:button_edit), edit_risk_path(@risk), class: 'icon icon-edit' %>
    <%= link_to l(:button_delete), risk_path(@risk), method: :delete,
          data: { confirm: l(:text_are_you_sure) }, class: 'icon icon-del' %>
    <%= link_to l(:label_review_new), new_risk_risk_review_path(@risk), class: 'icon icon-add' %>
    <%= link_to l(:label_action_new), new_risk_risk_mitigation_action_path(@risk), class: 'icon icon-add' %>
  <% end %>
</div>

<h2><%= @risk.title %></h2>

<div class="risk-header-badges">
  <%= risk_score_badge(@risk.current_score, @risk.criticality) %>
  &nbsp;
  <%= risk_trend_badge(@risk.trend) %>
  &nbsp;
  <span class="status"><%= l(:"risk_status_#{@risk.status}") %></span>
</div>

<div class="splitcontentleft">
  <table class="attributes">
    <tr>
      <th><%= l(:field_description) %></th>
      <td><%= simple_format(@risk.description) %></td>
    </tr>
    <tr>
      <th><%= l(:label_risk_cause) %></th>
      <td><%= simple_format(@risk.cause) %></td>
    </tr>
    <tr>
      <th><%= l(:label_risk_consequence) %></th>
      <td><%= simple_format(@risk.consequence) %></td>
    </tr>
    <tr>
      <th><%= l(:label_risk_category) %></th>
      <td><%= l(:"risk_category_#{@risk.category}") %></td>
    </tr>
    <tr>
      <th><%= l(:label_risk_assigned_to) %></th>
      <td><%= @risk.assigned_to&.name %></td>
    </tr>
    <tr>
      <th><%= l(:label_risk_review_date) %></th>
      <td><%= format_date(@risk.review_date) %></td>
    </tr>
  </table>
</div>

<div class="splitcontentright">
  <table class="attributes">
    <tr>
      <th colspan="2" class="section"><%= l(:label_risk_initial_eval) %></th>
    </tr>
    <tr>
      <th><%= l(:label_risk_probability) %></th>
      <td><%= probability_label(@risk.initial_probability) %> (<%= @risk.initial_probability %>)</td>
    </tr>
    <tr>
      <th><%= l(:label_risk_impact) %></th>
      <td><%= impact_label(@risk.initial_impact) %> (<%= @risk.initial_impact %>)</td>
    </tr>
    <tr>
      <th><%= l(:label_risk_score) %></th>
      <td><%= risk_score_badge(@risk.initial_score, :low) %></td>
    </tr>
    <tr>
      <th colspan="2" class="section"><%= l(:label_risk_current_eval) %></th>
    </tr>
    <tr>
      <th><%= l(:label_risk_probability) %></th>
      <td><%= probability_label(@risk.current_probability) %> (<%= @risk.current_probability %>)</td>
    </tr>
    <tr>
      <th><%= l(:label_risk_impact) %></th>
      <td><%= impact_label(@risk.current_impact) %> (<%= @risk.current_impact %>)</td>
    </tr>
    <tr>
      <th><%= l(:label_risk_score) %></th>
      <td><%= risk_score_badge(@risk.current_score, @risk.criticality) %></td>
    </tr>
  </table>
</div>

<div class="clear"></div>

<h3><%= l(:label_risk_mitigation_actions) %></h3>

<% if @actions.any? %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_title) %></th>
        <th><%= l(:label_action_type) %></th>
        <th><%= l(:label_risk_assigned_to) %></th>
        <th><%= l(:label_due_date) %></th>
        <th><%= l(:field_status) %></th>
        <th><%= l(:label_linked_issue) %></th>
        <% if @risk.editable? %><th></th><% end %>
      </tr>
    </thead>
    <tbody>
      <% @actions.each do |action| %>
        <tr class="<%= cycle('odd', 'even') %>">
          <td><%= action.title %></td>
          <td><%= l(:"action_type_#{action.action_type}") %></td>
          <td><%= action.assigned_to&.name %></td>
          <td class="<%= 'overdue' if action.due_date&.past? && action.status.in?(%w[open in_progress]) %>">
            <%= format_date(action.due_date) %>
          </td>
          <td><%= l(:"action_status_#{action.status}") %></td>
          <td>
            <% if action.issue %>
              <%= link_to "##{action.issue.id}", issue_path(action.issue) %>
            <% end %>
          </td>
          <% if @risk.editable? %>
            <td>
              <%= link_to l(:button_edit), edit_risk_risk_mitigation_action_path(@risk, action), class: 'icon icon-edit' %>
              <%= link_to l(:button_delete), risk_risk_mitigation_action_path(@risk, action), method: :delete,
                    data: { confirm: l(:text_are_you_sure) }, class: 'icon icon-del' %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>

<h3><%= l(:label_risk_review_history) %></h3>

<% if @reviews.any? %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:label_review_date) %></th>
        <th><%= l(:label_risk_probability) %></th>
        <th><%= l(:label_risk_impact) %></th>
        <th><%= l(:label_risk_score) %></th>
        <th><%= l(:label_comment) %></th>
        <th><%= l(:label_decision) %></th>
        <th><%= l(:label_author) %></th>
      </tr>
    </thead>
    <tbody>
      <% @reviews.each do |review| %>
        <tr class="<%= cycle('odd', 'even') %>">
          <td><%= format_time(review.reviewed_at) %></td>
          <td><%= review.probability %></td>
          <td><%= review.impact %></td>
          <td><%= risk_score_badge(review.score, :low) %></td>
          <td><%= simple_format(review.comment) %></td>
          <td><%= simple_format(review.decision) %></td>
          <td><%= review.author.name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_reviews_yet) %></p>
<% end %>
